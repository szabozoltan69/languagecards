server {
    listen 80;
    server_name XXXXXXXXX.hu www.XXXXXXXXX.hu;

    # Serve Django's collected static files directly - never proxy these to gunicorn | Check .env for static
    location /static/ {
        alias /home/django/www/XXXXXXXXX.hu/staticfiles/;
    }

    # Serve user-uploaded media files directly
    location /media/ {
        alias /home/django/www/XXXXXXXXX.hu/media/;
    }

    # Everything else goes to gunicorn
    location / {
        include proxy_params;
        proxy_pass http://unix:/run/gunicorn-XXXXXXXXX-hu.sock;
    }
}
